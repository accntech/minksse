{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "inlineSources": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "tests",
    "docs",
    "dist",
    "node_modules"
  ]
}
